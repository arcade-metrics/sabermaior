# Perfil prod (VM). Copie para .env.prod e ajuste. O embedding PRECISA ser o
# mesmo modelo usado na ingestão (bge-m3, 1024 dims), senão a busca quebra.

# Geração: vLLM na VM com GPU (perfil gpu do compose)...
LLM_BASE_URL=http://vllm:8000/v1
LLM_MODEL=Qwen/Qwen3-14B-AWQ
# ...ou uma API hospedada compatível com OpenAI:
# LLM_BASE_URL=https://api.exemplo.com/v1
# LLM_MODEL=nome-do-modelo
# LLM_API_KEY=

# Embeddings da pergunta: TEI com bge-m3 (CPU dá conta, só embeda a consulta).
# EMBED_MODEL é o nome gravado em trechos.modelo_embedding na ingestão (bge-m3);
# o TEI ignora esse campo e usa o --model-id do container.
EMBED_BASE_URL=http://tei-embed/v1
EMBED_MODEL=bge-m3
EMBED_DIM=1024

RERANK_PROVIDER=tei
RERANK_BASE_URL=http://tei-rerank

DATABASE_URL=postgresql://sabermaior:TROCAR@postgres:5432/sabermaior
